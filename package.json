    "trace-image": "node scripts/trace-image.ts",
    "render-svg": "node scripts/render-svg.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "svgo": "^4.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
