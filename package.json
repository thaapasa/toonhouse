{
  "name": "toonhouse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p . && pnpm -r --if-present typecheck",
    "test": "pnpm -r --no-bail --if-present test",
    "test:watch": "pnpm --filter @toonhouse/renderer test:watch",
    "build": "pnpm -r --if-present build",
    "generate-image": "node scripts/generate-image.ts",
    "trace-image": "node scripts/trace-image.ts",
    "render-svg": "node scripts/render-svg.ts",
    "font-metrics": "node scripts/font-metrics.ts",
    "web": "pnpm --filter @toonhouse/web dev",
    "studio": "pnpm --filter @toonhouse/studio dev",
    "prototypes": "pnpm --filter @toonhouse/prototypes dev",
    "server": "pnpm --filter @toonhouse/server dev",
    "migrate": "pnpm --filter @toonhouse/server migrate",
    "set-user": "pnpm --filter @toonhouse/server set-user",
    "group": "pnpm --filter @toonhouse/server group"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.10.0",
    "svgo": "^4.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
